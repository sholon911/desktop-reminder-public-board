{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面提醒公共栏",
  "version": "0.1.0",
  "identifier": "local.desktop-reminder-public-board",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "桌面提醒公共栏",
        "width": 390,
        "height": 520,
        "minWidth": 340,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
